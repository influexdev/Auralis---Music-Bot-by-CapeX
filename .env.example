DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=DISCORD_BOT_CLIENT_ID
# Optional: set this for fast slash-command updates in one test server
GUILD_ID=YOUR_DISCORD_SERVER_ID

# Your existing Lavalink server (hostname only, no https://)
LAVALINK_HOST=lavalinkv4.serenetia.com
LAVALINK_PORT=443
LAVALINK_PASSWORD=https://seretia.link/discord
LAVALINK_SECURE=true

# Default prefix; each server can override it
PREFIX=+

# Bot owner Discord user ID (comma separated for more than one owner).
# Owners can use blacklist and server commands.
OWNER_ID=DISCORD_USER_ID

# Support command: set a permanent invite link OR a server ID (bot must be in it and able to create invites)
# CHANGE SUPPORT_LINK to your discord server link.
SUPPORT_LINK=https://discord.gg/chnc6gfxhp
SUPPORT_SERVER_ID=1537483174265757886


# Lyrics: Genius API client access token (https://genius.com/api-clients). Optional, falls back to LRCLIB.
# DO NOT CHANGE THIS!
GENIUS_API_KEY=Xlkiow_TfoFHz_6tk5wkXFLwlmlbM6jWgcCANRQ4nDnc90GdharayqfIas7aft70

# MongoDB (required): stores server settings, 24/7 servers, blacklist and playlists
MONGODB_URI=YOUR_MONGO_DATABASE_URL
MONGODB_DB=Auralis